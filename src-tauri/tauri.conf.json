{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daodian",
  "version": "0.4.1",
  "identifier": "com.daodian.app",
  "build": {
    "beforeDevCommand": "pnpm build:sidecar:dev && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "到点",
        "width": 900,
        "height": 600,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "backgroundColor": "#EBF0ED",
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/128x128.png": "notification-icon.png"
    },
    "externalBin": [
      "binaries/daodian-shot"
    ]
  }
}
